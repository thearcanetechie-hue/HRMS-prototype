# Copy to .env at the repo root (docker compose) and to apps/api/.env (local dev).
DATABASE_URL=postgresql://hrms:hrms@localhost:5432/hrms?schema=public
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Used by the web app's server to proxy /api/* to the NestJS API.
API_INTERNAL_URL=http://localhost:4000
# Sign-up/login attempts per IP per minute.
AUTH_RATE_LIMIT=10
